NODE_ENV=production
HOST=0.0.0.0
PORT=8080
# Docker host binding. Keep the container port at 8080.
AUTOAPI_BIND_ADDRESS=0.0.0.0
AUTOAPI_PORT=8080
POSTGRES_PASSWORD=replace-with-a-long-postgres-password
DATABASE_URL=postgres://autoapi:replace-with-a-long-postgres-password@postgres:5432/autoapi
REDIS_URL=redis://redis:6379
ADMIN_TOKEN=replace-with-a-long-admin-token
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
GATEWAY_API_KEY=replace-with-a-client-api-key
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
HEALTH_CHECK_INTERVAL_MS=60000
UPSTREAM_TIMEOUT_MS=45000
FAILURE_THRESHOLD=3
TRUST_PROXY=false
ADMIN_LOGIN_RATE_LIMIT_MAX=10
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=300000
APP_MODE=production
DATA_DIR=.autoapi-data
# Disabled by default. Keep remote desktop authorization off in production.
CHECKIN_ENABLE_NOVNC=false
# Chromium runs inside the container on this virtual display. Do not remove it.
DISPLAY=:99
XDG_RUNTIME_DIR=/tmp/autoapi-runtime
# Maximum time to wait for Xvfb before the API is started.
DISPLAY_STARTUP_TIMEOUT_SECONDS=30
TZ=Asia/Shanghai
# Optional public URL shown in the dashboard, without the /v1 suffix.
PUBLIC_BASE_URL=http://localhost:8080
