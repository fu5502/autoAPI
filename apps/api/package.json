{
  "name": "@autoapi/api",
  "version": "0.2.13",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "import:memory-state": "tsx src/db/import-memory-state.ts",
    "migrate:checkin": "tsx src/checkin/migrate.ts",
    "backup:checkin": "tsx src/checkin/migrate.ts --backup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "^10.1.2",
    "fastify": "^5.5.0",
    "ioredis": "^5.7.0",
    "node-html-parser": "^7.0.1",
    "pg": "^8.16.3",
    "playwright-core": "^1.55.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
