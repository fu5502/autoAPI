{
  "name": "autoapi",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @autoapi/api --filter @autoapi/web dev",
    "dev:api": "pnpm --filter @autoapi/api dev",
    "dev:web": "pnpm --filter @autoapi/web dev",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @autoapi/api test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
